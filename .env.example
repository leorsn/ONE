# ONE public mobile environment variables.
# Never commit secret/service-role keys.

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# RevenueCat public SDK keys.
# Development clients use the internal BETA_PLAN when these are absent.
# Preview/production builds do NOT unlock paid access when RevenueCat is absent.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=YOUR_REVENUECAT_IOS_PUBLIC_SDK_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=YOUR_REVENUECAT_ANDROID_PUBLIC_SDK_KEY

# Server-only Supabase Edge Function secrets — DO NOT prefix with EXPO_PUBLIC and do not commit real values.
# OPENAI_API_KEY=SET_IN_SUPABASE_EDGE_FUNCTION_SECRETS
# ONE_RECALL_MODEL=gpt-5.6-luna
