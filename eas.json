{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "NEVER_REQUIRE_TARGET_SUPABASE": "1" }
    },
    "partner-preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "NEVER_REQUIRE_TARGET_SUPABASE": "1" }
    },
    "production": {
      "environment": "production",
      "env": { "NEVER_REQUIRE_TARGET_SUPABASE": "1" },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
