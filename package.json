{
  "name": "one-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "web:export": "expo export --platform web --output-dir .expo-web-test",
    "native:release-check": "node scripts/verify-native-config.mjs",
    "native:config": "expo config --type introspect > /tmp/one-expo-introspect.json",
    "release:env-check": "node scripts/verify-release-env.mjs",
    "release:asset-check": "node scripts/verify-store-assets.mjs",
    "release:privacy-check": "node scripts/verify-ios-privacy-manifests.mjs",
    "release:script-check": "node --check scripts/verify-release-env.mjs && node --check scripts/verify-store-assets.mjs && node --check scripts/verify-ios-privacy-manifests.mjs",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "quality": "npm run typecheck && npm run lint && npm run routes:check && npm test && npm run release:script-check && npx expo install --check && npx expo-doctor@latest && npm run native:release-check && npm run native:config && npm run web:export",
    "routes:check": "node scripts/verify-routes.mjs"
  },
  "dependencies": {
    "@expo/ui": "~57.0.19",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.115.0",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-ocr-kit": "0.1.4",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "10.9.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "typescript": "~6.0.3"
  }
}
